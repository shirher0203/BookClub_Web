# BookClub server env template. Copy to `server/.env` and fill in real values.
# Every var listed here is required: `src/server.ts` fails fast at boot if any are missing.
# Never commit a filled-in `.env` — it is gitignored.

# Runtime mode. Use `production` on the college server (also injected by pm2.config.js).
NODE_ENV=
# TCP port the HTTPS server binds to. Prod: 443 (see PROJECT_PLAN §13). Local dev: any free high port, e.g. 5443.
PORT=
# MongoDB connection string. Prod (college): mongodb://admin:<url-encoded-pwd>@localhost:21771/bookclub?authSource=admin
MONGO_URI=
# Secret used to sign JWT access tokens. Long, random, not shared with the refresh secret.
JWT_SECRET=
# Secret used to sign refresh tokens. Must differ from JWT_SECRET.
REFRESH_TOKEN_SECRET=
# Access token lifetime (e.g. 15m). Read by the auth controller when issuing tokens.
ACCESS_TOKEN_EXPIRY=
# Refresh token lifetime (e.g. 7d). Stored on the token record as expiresAt.
REFRESH_TOKEN_EXPIRY=
# Google OAuth 2.0 client ID (from Google Cloud Console).
GOOGLE_CLIENT_ID=
# Google OAuth 2.0 client secret.
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI in Google Cloud, byte-for-byte. Prod: https://node75.cs.colman.ac.il/api/auth/google/callback
GOOGLE_CALLBACK_URL=
# Google Gemini API key for AI search / review analysis.
GEMINI_API_KEY=
# Origin of the browser client. Used for CORS and as the OAuth success redirect base. Prod: https://node75.cs.colman.ac.il
CLIENT_URL=
# Absolute path to the TLS private key (PEM). HTTPS server reads this at boot.
SSL_KEY_PATH=
# Absolute path to the TLS certificate (PEM).
SSL_CERT_PATH=
